# Copy this file to .env and fill in your own values. Never commit .env.

# Spotify (only needed for the "spotify" data source). Create an app at https://developer.spotify.com/dashboard
# and add the redirect URI below to it exactly. The app owner needs Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8235/callback

# Genius lyrics (optional but recommended). Create a client at https://genius.com/api-clients
# and use its "Client Access Token".
GENIUS_API_TOKEN=

# Default data source when a request does not say: csv or spotify
MOODIFY_SOURCE=csv

# Local LLM through Ollama (optional). Install Ollama, then: ollama pull qwen2.5:3b
LLM_ENABLED=true
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT=180
